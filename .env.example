# 复制这个文件为 .env，填入真实值。.env 已被 .gitignore 忽略，不会被提交。
#
# Windows 上更推荐直接把 Key 设成系统环境变量（见「环境搭建指南」第 3 步），
# 因为 IDE 和命令行都能读到，不用每次手动加载 .env。

# 阿里云百炼（DashScope）API Key，形如 sk-xxxxxxxx
AI_DASHSCOPE_API_KEY=sk-your-key-here

# ---- 下面这些是 docker-compose.yml 里用的，本地开发默认值，不用改 ----
# RAG 向量库
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=rag_db
PGVECTOR_USER=sdaq
PGVECTOR_PASSWORD=sdaq_dev_pwd

# 业务库（给 Text2SQL 用）
BUSINESS_DB_HOST=localhost
BUSINESS_DB_PORT=5433
BUSINESS_DB_NAME=business_db
BUSINESS_DB_USER=sdaq
BUSINESS_DB_PASSWORD=sdaq_dev_pwd
